{
  "manifest_version": 3,
  "name": "Keep Vault MCK Capture",
  "version": "0.1.1",
  "description": "Capture selected text on demand, with a private editable preview.",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "Keep Vault MCK Capture"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Keep Vault MCK capture"}}
}
